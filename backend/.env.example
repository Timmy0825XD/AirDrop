NODE_ENV=development
PORT=3000

# Supabase → Project Settings → Database → Connection string
# URI del Session pooler (puerto 5432), NO el Transaction pooler (6543).
# Ejemplo: postgresql://postgres.XXXX:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.XXXX:TU_CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

JWT_SECRET=cambia-esta-clave-en-local
JWT_EXPIRES_IN=8h

ADMIN_EMAIL=admin@airdrop.local
ADMIN_PASSWORD=Admin1234
ADMIN_FULL_NAME=Administrador AirDrop
