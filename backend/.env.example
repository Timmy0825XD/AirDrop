NODE_ENV=development
PORT=3000

# Supabase → Project Settings → Database → Connection string
# URI del Session pooler (puerto 5432), NO el Transaction pooler (6543).
# Ejemplo: postgresql://postgres.XXXX:CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.XXXX:TU_CLAVE@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

JWT_SECRET=cambia-esta-clave-en-local
JWT_EXPIRES_IN=2h

ADMIN_EMAIL=administrador.plataforma@gmail.com
ADMIN_PASSWORD=Admin1234
ADMIN_FULL_NAME=Administrador AirDrop

# Supabase → Project Settings → API Keys.
# service_role es secreta y solo vive en este backend. No va en Flutter.
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Brevo → SMTP & API → API keys. El remitente tiene que estar verificado en Senders.
# POST https://api.brevo.com/v3/smtp/email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=AirDrop

# Redis del snapshot de vuelo. Sin esta URL el reloj no arranca.
REDIS_URL=redis://localhost:6379

# Espera del código de entrega en ms (por defecto 300000 = 5 min). Solo para acortarla en pruebas.
# DELIVERY_WAIT_MS=10000
