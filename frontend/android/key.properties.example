# Copia este archivo como key.properties y completa los valores solo en tu PC.
# key.properties y las llaves .jks/.keystore ya estan excluidos de Git.
# Para trabajar en debug no necesitas este archivo ni una llave de release.
# Guarda la llave fuera del repositorio; en Windows puedes usar barras /.
storePassword=
keyPassword=
keyAlias=airdrop
storeFile=C:/Users/HP/airdrop-release.jks
